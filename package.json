{
  "name": "plotline-backend-bun-port",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run ./src/index.ts",
    "dev": "bun --watch run ./src/index.ts",
    "test:git": "bun test src",
    "test:db": "RUN_DB_TESTS=1 bun test src/db",
    "db:reset": "bun run db/reset.ts",
    "import:openlibrary": "bun run src/import/openlibrary/run.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}